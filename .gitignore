# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Выходы прогонов: артефакты бенчмарка держим (на них ссылается README),
# остальное — мусор прогона
out/*
!out/research_bench.json
*.png.tmp

# Секреты и окружение
.env
*.env
!.sample.env

# Данные (реальные выгрузки не храним в гите).
# Пример для быстрого старта — исключение: на него ссылаются README и user-guide.
data/sample/*.csv
!data/sample/history.csv
!data/sample/.gitkeep

# Артефакты визуальной проверки диаграммы (пересоздаются командой visual-check)
docs/*.visual-check.*

# OS
.DS_Store
